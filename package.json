{
  "name": "epics-template",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/prepare-local-records.mjs && nuxt build",
    "dev": "node scripts/prepare-local-records.mjs && nuxt dev",
    "generate": "node scripts/prepare-local-records.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prisma:reset": "prisma migrate reset && prisma generate && prisma db seed",
    "test": "node scripts/prepare-local-records.mjs && tsx --test \"server/utils/ai/*.test.ts\" app/components/database-redesign/aiResultPresentation.test.ts",
    "check:views": "node scripts/prepare-local-records.mjs && tsx scripts/check-redesign-vue-views.ts",
    "prepare:records": "node scripts/prepare-local-records.mjs"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.4.0",
    "@octokit/rest": "^22.0.1",
    "@tanstack/vue-table": "^8.21.3",
    "@types/nodemailer": "^7.0.4",
    "better-auth": "^1.4.7",
    "chart.js": "^4.5.1",
    "discord.js": "^14.26.5",
    "dotenv": "^17.2.3",
    "jspdf": "^4.2.1",
    "nodemailer": "^7.0.11",
    "nuxt": "^4.3.1",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.1",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vue-tsc": "~3.1.8"
  }
}
